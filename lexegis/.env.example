# Required
LEXEGIS_JWT_SECRET=change-me-to-32-plus-random-bytes

# Where the web app is published
LEXEGIS_PORT=8080

# Optional: Wolfram adjudication (either transport)
WOLFRAM_APP_ID=
WOLFRAM_MCP_URL=

# Optional: Lean 4 certification (path to a toolchain inside the engine image)
LEXEGIS_LEAN_BIN=lean

# Optional: Stripe billing. Without these the plan endpoints run self-serve.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
